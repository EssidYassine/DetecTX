# ── DeTecTX — configuration (copier vers .env et adapter) ────────────────

# PostgreSQL (base applicative)
POSTGRES_USER=detectx
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=detectx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# OpenSearch (events / logs)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Str0ng!Passw0rd_change_me
# En dev on désactive le plugin sécurité OpenSearch. À RÉACTIVER en prod.
OPENSEARCH_USE_SSL=false

# Redis (cache + broker Celery)
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
# Généré via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_real_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000

# Couche IA — provider: openai | anthropic | ollama
LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Threat Intelligence (optionnel au départ)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
