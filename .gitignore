assets/3d/*.blend
assets/3d/*.blend1
assets/3d/*_preview.png

# SigmaHQ : échantillons de régression inutiles au runtime (35 Mo)
backend/app/detection/_sigma_src/regression_data/

# Notes locales de démarrage (contiennent des secrets : webhook, JWT)
START APP.txt

# État du collecteur intégré (marque-pages des journaux)
backend/data/
